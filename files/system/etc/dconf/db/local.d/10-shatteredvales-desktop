# Home Edition desktop defaults. These are defaults, not locks: everyone
# keeps the ability to change anything. Values in @...@ are filled from
# branding/brand.env at build time.

[org/gnome/shell]
enabled-extensions=['dash-to-dock@micxgx.gmail.com', 'appindicatorsupport@rgcjonas.gmail.com', 'logomenu@aryan_k', 'just-perfection-desktop@just-perfection']
# GNOME's own "Welcome / Take Tour" prompt is replaced by the Welcome window
# from Family Setup. With both, GNOME's modal prompt covered ours and held
# keyboard and mouse input until dismissed, which a first-time user would
# not know to do. Marking it as already shown for any GNOME version keeps
# it away; the Tour app stays in the app list.
welcome-dialog-last-shown-version='999999'
# A short dock of everyday apps, like a phone's home row. The RPM-provided
# entries are checked by verify-image.sh so an upstream rename fails the
# build; VLC is a first-boot Flatpak and the Craft apps install at first
# login, so they appear in the dock as soon as they are installed.
favorite-apps=['org.mozilla.firefox.desktop', 'org.gnome.Nautilus.desktop', 'ai.storyteller.photocraft.desktop', 'ai.storyteller.wordcraft.desktop', 'org.videolan.VLC.desktop', 'org.gnome.Settings.desktop', 'shatteredvales-update.desktop']

[org/gnome/desktop/wm/preferences]
# macOS-style window controls on the left.
button-layout='close,minimize,maximize:'

[org/gnome/desktop/interface]
color-scheme='prefer-dark'
# libadwaita apps only accept GNOME's fixed accent palette, so the closest
# named color is used here; exact brand colors apply to the shell CSS.
accent-color='@BRAND_GNOME_ACCENT@'
font-name='@BRAND_FONT_FAMILY@ 11'
document-font-name='@BRAND_FONT_FAMILY@ 11'
monospace-font-name='@BRAND_MONO_FONT_FAMILY@ 11'
clock-format='12h'
clock-show-weekday=true

[org/gnome/desktop/background]
picture-uri='file:///usr/share/backgrounds/shatteredvales/wallpaper.png'
picture-uri-dark='file:///usr/share/backgrounds/shatteredvales/wallpaper.png'
picture-options='zoom'
primary-color='@BRAND_BG@'

[org/gnome/desktop/screensaver]
picture-uri='file:///usr/share/backgrounds/shatteredvales/wallpaper.png'

[org/gnome/shell/extensions/dash-to-dock]
dock-position='BOTTOM'
dock-fixed=true
extend-height=false
dash-max-icon-size=48
show-trash=false
show-mounts=false
click-action='minimize-or-previews'
custom-theme-shrink=true

[org/gnome/shell/extensions/Logo-menu]
# Replaces the Activities button with an Apple-style menu using the org logo.
use-custom-icon=true
custom-icon-path='/usr/share/pixmaps/shatteredvales-logo-symbolic.svg'
show-activities-button=true
# Logo Menu defaults to gnome-terminal; this image ships Ptyxis.
menu-button-terminal='ptyxis'

[org/gnome/shell/extensions/just-perfection]
# Start on the desktop with the dock, like a phone's home screen, rather
# than GNOME's Activities overview (0 = desktop, 1 = overview).
startup-status=0
# Clock position in the top bar: 0 = center, 1 = right, 2 = left.
clock-menu-position=1
clock-menu-position-offset=0
