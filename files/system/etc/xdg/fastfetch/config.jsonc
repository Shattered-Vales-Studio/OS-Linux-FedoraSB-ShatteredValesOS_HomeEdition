// System summary shown by `fastfetch`, in the studio's colours, with the
// logo rendered by scripts/render-branding.sh. A user's own
// ~/.config/fastfetch/config.jsonc takes precedence over this file.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file-raw",
    "source": "/usr/share/shatteredvales/fastfetch/logo.txt",
    "padding": { "top": 1, "right": 3 }
  },
  "display": {
    "separator": "  ",
    // Brand gold (#c5a059) for keys and the title.
    "color": { "keys": "38;2;197;160;89", "title": "38;2;197;160;89" }
  },
  "modules": [
    "title",
    "separator",
    "os",
    "kernel",
    "uptime",
    "packages",
    "shell",
    "de",
    "terminal",
    "cpu",
    "gpu",
    "memory",
    "disk",
    "break",
    { "type": "custom", "format": "https://shatteredvales.studio" }
  ]
}
