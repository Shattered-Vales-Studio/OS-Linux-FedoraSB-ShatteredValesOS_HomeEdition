# Home Edition default applications. Applies to every account; anything a
# person picks in Settings > Apps > Default Apps or Open With > Always takes
# precedence. Each type lists apps in order: when the first is not installed
# (yet), the next is used. Craft apps install for each person at first login.

[Default Applications]

# Web: Firefox. It plays the streaming services (Widevine), which Chromium
# cannot.
x-scheme-handler/http=org.mozilla.firefox.desktop;
x-scheme-handler/https=org.mozilla.firefox.desktop;
text/html=org.mozilla.firefox.desktop;
application/xhtml+xml=org.mozilla.firefox.desktop;

# Office documents: WordCraft, GridCraft and DeckCraft; PDFs in PdfCraft
# with GNOME Papers as the fallback.
application/vnd.openxmlformats-officedocument.wordprocessingml.document=ai.storyteller.wordcraft.desktop;
application/vnd.openxmlformats-officedocument.wordprocessingml.template=ai.storyteller.wordcraft.desktop;
application/vnd.ms-word.document.macroEnabled.12=ai.storyteller.wordcraft.desktop;
application/msword=ai.storyteller.wordcraft.desktop;
application/vnd.oasis.opendocument.text=ai.storyteller.wordcraft.desktop;
application/rtf=ai.storyteller.wordcraft.desktop;
text/rtf=ai.storyteller.wordcraft.desktop;
application/vnd.openxmlformats-officedocument.presentationml.presentation=ai.storyteller.deckcraft.desktop;
application/vnd.openxmlformats-officedocument.presentationml.slideshow=ai.storyteller.deckcraft.desktop;
application/vnd.openxmlformats-officedocument.presentationml.template=ai.storyteller.deckcraft.desktop;
application/vnd.ms-powerpoint=ai.storyteller.deckcraft.desktop;
application/x-deckcraft=ai.storyteller.deckcraft.desktop;
application/vnd.openxmlformats-officedocument.spreadsheetml.sheet=ai.storyteller.gridcraft.desktop;
application/vnd.ms-excel.sheet.macroEnabled.12=ai.storyteller.gridcraft.desktop;
application/vnd.ms-excel=ai.storyteller.gridcraft.desktop;
application/vnd.oasis.opendocument.spreadsheet=ai.storyteller.gridcraft.desktop;
text/csv=ai.storyteller.gridcraft.desktop;
text/tab-separated-values=ai.storyteller.gridcraft.desktop;
application/pdf=ai.storyteller.pdfcraft.desktop;org.gnome.Papers.desktop;

# Photos: open in the Image Viewer to look, PhotoCraft offered second to
# edit; camera raw files and layered images open straight in the editors.
image/png=org.gnome.Loupe.desktop;ai.storyteller.photocraft.desktop;
image/jpeg=org.gnome.Loupe.desktop;ai.storyteller.photocraft.desktop;
image/webp=org.gnome.Loupe.desktop;ai.storyteller.photocraft.desktop;
image/gif=org.gnome.Loupe.desktop;ai.storyteller.photocraft.desktop;
image/bmp=org.gnome.Loupe.desktop;ai.storyteller.photocraft.desktop;
image/tiff=org.gnome.Loupe.desktop;ai.storyteller.photocraft.desktop;
image/avif=org.gnome.Loupe.desktop;ai.storyteller.photocraft.desktop;
image/heic=org.gnome.Loupe.desktop;ai.storyteller.photocraft.desktop;
image/heif=org.gnome.Loupe.desktop;ai.storyteller.photocraft.desktop;
image/x-icon=org.gnome.Loupe.desktop;ai.storyteller.photocraft.desktop;
image/vnd.microsoft.icon=org.gnome.Loupe.desktop;ai.storyteller.photocraft.desktop;
image/vnd.adobe.photoshop=ai.storyteller.photocraft.desktop;
image/x-psd=ai.storyteller.photocraft.desktop;
image/x-psb=ai.storyteller.photocraft.desktop;
image/openraster=ai.storyteller.photocraft.desktop;
image/x-exr=ai.storyteller.photocraft.desktop;
image/x-tga=ai.storyteller.photocraft.desktop;
image/qoi=ai.storyteller.photocraft.desktop;
application/x-photocraft=ai.storyteller.photocraft.desktop;
image/x-adobe-dng=ai.storyteller.lightcraft.desktop;ai.storyteller.photocraft.desktop;
image/x-sony-arw=ai.storyteller.lightcraft.desktop;ai.storyteller.photocraft.desktop;
image/x-canon-cr2=ai.storyteller.lightcraft.desktop;ai.storyteller.photocraft.desktop;
image/x-canon-cr3=ai.storyteller.lightcraft.desktop;ai.storyteller.photocraft.desktop;
image/x-nikon-nef=ai.storyteller.lightcraft.desktop;ai.storyteller.photocraft.desktop;
image/x-fuji-raf=ai.storyteller.lightcraft.desktop;ai.storyteller.photocraft.desktop;
image/x-olympus-orf=ai.storyteller.lightcraft.desktop;ai.storyteller.photocraft.desktop;
image/x-panasonic-rw2=ai.storyteller.lightcraft.desktop;ai.storyteller.photocraft.desktop;
image/x-panasonic-rw=ai.storyteller.lightcraft.desktop;ai.storyteller.photocraft.desktop;
image/x-pentax-pef=ai.storyteller.lightcraft.desktop;ai.storyteller.photocraft.desktop;

# Video in VLC (plays nearly everything), GNOME Video Player second.
video/mp4=org.videolan.VLC.desktop;org.gnome.Showtime.desktop;
video/x-m4v=org.videolan.VLC.desktop;org.gnome.Showtime.desktop;
video/quicktime=org.videolan.VLC.desktop;org.gnome.Showtime.desktop;
video/x-matroska=org.videolan.VLC.desktop;org.gnome.Showtime.desktop;
video/webm=org.videolan.VLC.desktop;org.gnome.Showtime.desktop;
video/x-msvideo=org.videolan.VLC.desktop;org.gnome.Showtime.desktop;
video/vnd.avi=org.videolan.VLC.desktop;org.gnome.Showtime.desktop;
video/mpeg=org.videolan.VLC.desktop;org.gnome.Showtime.desktop;
video/mp2t=org.videolan.VLC.desktop;org.gnome.Showtime.desktop;

# Music: GNOME Audio Player, VLC second.
audio/midi=org.gnome.Decibels.desktop;org.videolan.VLC.desktop;
audio/x-midi=org.gnome.Decibels.desktop;org.videolan.VLC.desktop;
audio/mpeg=org.gnome.Decibels.desktop;org.videolan.VLC.desktop;
audio/flac=org.gnome.Decibels.desktop;org.videolan.VLC.desktop;
audio/x-flac=org.gnome.Decibels.desktop;org.videolan.VLC.desktop;
audio/ogg=org.gnome.Decibels.desktop;org.videolan.VLC.desktop;
audio/wav=org.gnome.Decibels.desktop;org.videolan.VLC.desktop;
audio/x-wav=org.gnome.Decibels.desktop;org.videolan.VLC.desktop;
audio/vnd.wave=org.gnome.Decibels.desktop;org.videolan.VLC.desktop;
audio/aiff=org.gnome.Decibels.desktop;org.videolan.VLC.desktop;
audio/x-aiff=org.gnome.Decibels.desktop;org.videolan.VLC.desktop;

# Plain text
text/plain=org.gnome.TextEditor.desktop;
text/markdown=org.gnome.TextEditor.desktop;
