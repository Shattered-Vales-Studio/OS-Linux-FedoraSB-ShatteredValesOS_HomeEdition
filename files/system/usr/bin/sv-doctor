#!/usr/bin/env bash
#
# sv-doctor
#
# Purpose:
#   One-command health check for whoever helps look after the computer.
#   Reports the OS image and channel, pending updates, GPU/image match, disk
#   space, remote help (Tailscale), first-boot app installs and the
#   per-person setup steps, each as PASS, WARN or FAIL with a suggested fix.
#
# Usage:
#   sv-doctor           Print the report.
#   sv-doctor --copy    Print it and copy it to the clipboard, ready to paste
#                       into a support message.
#
# Exit codes:
#   0 when nothing failed, 1 when at least one check failed.

set -uo pipefail

readonly FLATPAK_CONFIG=/usr/share/bluebuild/default-flatpaks/configuration.yaml
readonly STATE_DIR="${XDG_STATE_HOME:-${HOME}/.local/state}/shatteredvales"
readonly FIRST_LOGIN=/usr/libexec/shatteredvales/first-login.sh

FAILED=0
WARNED=0

# report
#   Prints one result line and records failures and warnings.
#   Arguments: $1 PASS, WARN, FAIL or INFO, $2 check name, $3 detail
#   Returns: 0 always
report() {
    local colour
    case "$1" in
        PASS) colour=32 ;;
        WARN) colour=33; WARNED=$((WARNED + 1)) ;;
        FAIL) colour=31; FAILED=$((FAILED + 1)) ;;
        *)    colour=36 ;;
    esac
    if [[ -t 1 ]]; then
        printf '\033[1;%sm%-4s\033[0m  %-16s %s\n' "${colour}" "$1" "$2" "$3"
    else
        printf '%-4s  %-16s %s\n' "$1" "$2" "$3"
    fi
}

# deployment_field
#   Reads a field from the booted or staged deployment.
#   Arguments: $1 "booted" or "staged", $2 field name
#   Output: the value, or nothing
#   Returns: 0 always
deployment_field() {
    rpm-ostree status --json 2>/dev/null \
        | jq -r --arg which "$1" --arg field "$2" \
            '.deployments[] | select(.[$which] == true) | .[$field] // empty' \
        | head -n1
}

# check_image
#   Reports the running image, its channel and whether it is signature
#   verified, plus any update waiting for a restart.
#   Arguments: none
#   Returns: 0 always
check_image() {
    local ref staged built age
    ref="$(deployment_field booted container-image-reference)"
    if [[ -z "${ref}" ]]; then
        report FAIL "OS image" "Not running from a container image (rpm-ostree status failed)"
        return
    fi
    report INFO "OS image" "${ref#*docker://} ($(deployment_field booted version))"
    case "${ref}" in
        ostree-image-signed:*) report PASS "Signature" "Updates are signature-verified" ;;
        *) report WARN "Signature" "Unverified image; rebase to ostree-image-signed:docker://${ref#*docker://} (see README)" ;;
    esac

    staged="$(deployment_field staged checksum)"
    if [[ -n "${staged}" ]]; then
        built="$(deployment_field staged timestamp)"
        age=$(( ($(date +%s) - built) / 86400 ))
        if (( age >= 3 )); then
            report WARN "Update" "Waiting ${age} days for a restart; save work and restart"
        else
            report INFO "Update" "Ready, applies at the next restart"
        fi
    else
        report PASS "Update" "No update waiting"
    fi
}

# check_gpu
#   Confirms the image variant matches the installed GPU.
#   Arguments: none
#   Returns: 0 always
check_gpu() {
    local output
    if output="$(sv-gpu-image check 2>&1)"; then
        report PASS "GPU image" "Image matches the graphics hardware"
    else
        # sv-gpu-image check already explains the fix in its message.
        report FAIL "GPU image" "${output:-Image does not match the GPU; run: sudo sv-gpu-image apply}"
    fi
}

# check_disk
#   Warns when the system or home filesystem is nearly full. / is a
#   read-only composefs mount that always reports 100%, so the real system
#   disk is measured at /sysroot. Home is reported separately only when it
#   lives on a different filesystem.
#   Arguments: none
#   Returns: 0 always
check_disk() {
    local mount used
    local -a mounts=(/sysroot)
    # Compared by backing device, not stat's st_dev, which differs between
    # btrfs subvolumes on the same disk.
    if [[ "$(df --output=source /sysroot | tail -n1)" != "$(df --output=source "${HOME}" | tail -n1)" ]]; then
        mounts+=("${HOME}")
    fi
    for mount in "${mounts[@]}"; do
        used="$(df --output=pcent "${mount}" | tail -n1 | tr -dc '0-9')"
        if (( used >= 95 )); then
            report FAIL "Disk ${mount}" "${used}% full; free space now (empty the Trash, move videos and photos off)"
        elif (( used >= 85 )); then
            report WARN "Disk ${mount}" "${used}% full"
        else
            report PASS "Disk ${mount}" "${used}% used"
        fi
    done
}

# check_tailscale
#   Reports whether remote help (Tailscale) is set up. Not being signed in
#   is normal: Tailscale stays idle until someone chooses to set it up.
#   Arguments: none
#   Returns: 0 always
check_tailscale() {
    local state
    state="$(tailscale status --json 2>/dev/null | jq -r '.BackendState // empty')"
    case "${state}" in
        Running) report PASS "Remote help" "Tailscale connected as $(tailscale status --json | jq -r '.Self.DNSName' | sed 's/\.$//')" ;;
        "")      report WARN "Tailscale" "tailscaled is not responding; sudo systemctl restart tailscaled" ;;
        NeedsLogin|Stopped|NoState)
                 report INFO "Remote help" "Not set up (optional); see Getting Remote Help in Documents" ;;
        *)       report WARN "Tailscale" "${state}; reconnect with: sudo tailscale up --ssh" ;;
    esac
}

# check_flatpaks
#   Compares installed system Flatpaks with the first-boot app list.
#   Arguments: none
#   Returns: 0 always
check_flatpaks() {
    local -a wanted missing=()
    local app installed
    mapfile -t wanted < <(grep -E '^\s+- [A-Za-z0-9_-]+(\.[A-Za-z0-9_-]+)+\s*$' "${FLATPAK_CONFIG}" 2>/dev/null | sed -E 's/^\s+- //; s/\s+$//')
    installed="$(flatpak list --system --app --columns=application 2>/dev/null)"
    for app in "${wanted[@]}"; do
        grep -qx "${app}" <<<"${installed}" || missing+=("${app}")
    done
    if (( ${#wanted[@]} == 0 )); then
        report WARN "Apps" "Could not read the app list"
    elif (( ${#missing[@]} == 0 )); then
        report PASS "Apps" "All ${#wanted[@]} apps installed"
    else
        report WARN "Apps" "${#missing[@]} of ${#wanted[@]} still installing or failed: ${missing[*]}"
    fi
}

# check_first_login
#   Compares completed per-user setup steps with those first-login.sh runs.
#   Arguments: none
#   Returns: 0 always
check_first_login() {
    local -a steps pending=()
    local step
    mapfile -t steps < <(grep -oE 'run_step [a-z0-9-]+' "${FIRST_LOGIN}" | awk '{print $2}')
    for step in "${steps[@]}"; do
        [[ -f "${STATE_DIR}/${step}.done" ]] || pending+=("${step}")
    done
    if (( ${#pending[@]} == 0 )); then
        report PASS "User setup" "All ${#steps[@]} first-login steps done"
    else
        report WARN "User setup" "Pending: ${pending[*]}; run sv-first-login, log: ${STATE_DIR}/first-login.log"
    fi
}

# run_checks
#   Runs every check and prints the summary.
#   Arguments: none
#   Returns: 0 always
run_checks() {
    echo "Shattered Vales OS Home Edition report: $(hostname), user ${USER}, $(date '+%Y-%m-%d %H:%M %Z')"
    echo
    check_image
    check_gpu
    check_disk
    check_tailscale
    check_flatpaks
    check_first_login
    echo
    echo "Summary: ${FAILED} failed, ${WARNED} warnings"
}

# main
#   Prints the report, optionally copying it to the clipboard.
#   Arguments: $1 optional --copy
#   Returns: 1 if any check failed, 0 otherwise
main() {
    if [[ "${1:-}" == --copy ]]; then
        local report_text
        report_text="$(run_checks)"
        printf '%s\n' "${report_text}"
        if printf '%s\n' "${report_text}" | wl-copy 2>/dev/null; then
            echo "Copied to the clipboard."
        else
            echo "Could not copy to the clipboard; select and copy the text above."
        fi
        # The counters were updated in the subshell; recount from the text.
        grep -q '^FAIL' <<<"${report_text}" && exit 1
        exit 0
    fi
    run_checks
    (( FAILED == 0 ))
}

main "$@"
