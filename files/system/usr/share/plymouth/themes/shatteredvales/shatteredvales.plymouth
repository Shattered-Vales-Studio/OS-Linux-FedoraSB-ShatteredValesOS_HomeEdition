[Plymouth Theme]
Name=Shattered Vales
Description=Shattered Vales OS Home Edition boot splash
ModuleName=two-step

[two-step]
ImageDir=/usr/share/plymouth/themes/shatteredvales
HorizontalAlignment=.5
VerticalAlignment=.75
WatermarkHorizontalAlignment=.5
WatermarkVerticalAlignment=.45
DialogHorizontalAlignment=.5
DialogVerticalAlignment=.6
Transition=none
TransitionDuration=0.0
BackgroundStartColor=@BRAND_BG_HEX@
BackgroundEndColor=@BRAND_BG_HEX@

[boot-up]
UseEndAnimation=false

[shutdown]
UseEndAnimation=false

[reboot]
UseEndAnimation=false
