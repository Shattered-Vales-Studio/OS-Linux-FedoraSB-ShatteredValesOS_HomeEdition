# Single source of truth for Shattered Vales brand values.
# `just branding` renders artwork from this file and copies it into the image.
# Every value mirrors a design token in https://shatteredvales.studio
# (assets/css/variables.css); the token name is noted beside each one.

BRAND_OS_NAME="Shattered Vales OS"
# Edition shown under the OS name (Settings > About, login screen, lock
# screen and boot splash) and in os-release VARIANT.
BRAND_EDITION="Home Edition"
BRAND_EDITION_ID="home"
BRAND_URL="https://shatteredvales.studio"
# Where people report problems with the OS (os-release BUG_REPORT_URL) and
# find its guides (DOCUMENTATION_URL).
BRAND_REPO_URL="https://github.com/Shattered-Vales-Studio/OS-Linux-FedoraSB-ShatteredValesOS_HomeEdition"
BRAND_DOCS_URL="https://shatteredvales.studio/guide/"

# Two-line wordmark used on the lock screen and boot splash. Written in
# title case; the renderer uppercases it exactly like the site's
# .brand-title rule does.
BRAND_NAME_LINE1="Shattered Vales OS"
BRAND_NAME_LINE2="Home Edition"

# Surfaces and text. Contrast ratios are against BRAND_BG (WCAG 2.2).
BRAND_BG="#050505"             # --color-bg
BRAND_BG_GLOW="#111111"        # --color-bg-glow, centre of the page gradient
BRAND_SURFACE="#0a0a0a"        # --color-surface
BRAND_BORDER="#222222"         # --color-surface-border
BRAND_TEXT="#f8f8f8"           # --color-text            19.2:1 AAA
BRAND_TEXT_MUTED="#a3a3a3"     # --color-text-muted       8.1:1 AAA

# Gold. GNOME Shell CSS cannot clip a gradient to text, so UI text and
# buttons use the flat BRAND_ACCENT (8.3:1 AAA, and the same 8.3:1 for
# BRAND_BG text on an accent button). Rendered artwork uses the full foil.
BRAND_ACCENT="#c5a059"         # --gold-base
BRAND_ACCENT_LIGHT="#e0cba0"   # --gold-nav, hover/focus tint 12.8:1 AAA

# --gradient-gold-foil, left to right. The darkest stop is 5.2:1 on
# BRAND_BG, so every pixel of foil lettering still meets WCAG AA.
BRAND_FOIL_STOPS="#bf953f #fcf6ba #b38728 #fbf5b7 #aa771c"

# Edition blue for the "HOME EDITION" line in Settings > About and on the
# login screen. Not a website token: the site has no blue, and the edition
# needs a colour that reads as distinct from the gold. Contrast (WCAG 2.2):
#   dark  on libadwaita dark  #222226  8.1:1 AAA, on BRAND_BG 10.4:1 AAA
#   light on libadwaita light #fafafb  8.2:1 AAA
BRAND_EDITION_BLUE_DARK="#8cbcff"
BRAND_EDITION_BLUE_LIGHT="#1a4a94"

# Red foil for administrator account pictures, the same five-stop shape as
# the gold foil so administrators are recognisable at a glance in the user
# list while staying in the brand's metallic style. Artwork only (WCAG
# 1.4.11 graphics, 3:1): the darkest stop, #c43842, is 3.6:1 on the avatar
# background's lightest point (BRAND_BG_GLOW).
BRAND_ADMIN_FOIL_STOPS="#d43a44 #f2918c #cc3540 #ef8a85 #c43842"

# Closest entry in GNOME's fixed accent palette for libadwaita apps
# (blue, teal, green, yellow, orange, red, pink, purple, slate). GNOME's
# yellow (#c88800) is the nearest hue to --gold-base.
BRAND_GNOME_ACCENT="yellow"

# Fonts. Family names must match the Google Fonts names listed in
# recipes/common/desktop.yml; the .ttf files are used to render artwork.
# The site sets body copy in Lato, headings/wordmark in Cinzel and code in
# JetBrains Mono.
BRAND_FONT_FAMILY="Lato"                 # --font-body
BRAND_DISPLAY_FONT_FAMILY="Cinzel"       # --font-display
BRAND_CLOCK_FONT_FAMILY="Cinzel"
BRAND_MONO_FONT_FAMILY="JetBrains Mono"  # --font-mono, terminals and editors
BRAND_FONT_FILE="branding/source/fonts/Lato-Regular.ttf"
BRAND_FONT_BOLD_FILE="branding/source/fonts/Lato-Bold.ttf"
BRAND_DISPLAY_FONT_FILE="branding/source/fonts/Cinzel-Bold.ttf"
